# 수집 원본 데이터 (자세당 PNG 8MB + 라이다 npy 5MB, 카메라당 ~180MB)
# 결과는 calib_result/ 에 있고, 재수집 방법은 calib_result/SUMMARY.md 참고
calib_data/

# 카메라+라이다 동시 녹화 (record_session.py 출력)
recording_10s/
recording_*/

# 내부 파라미터 검증용 임시 촬영
verify_shots/
verify_captures/

__pycache__/
*.pyc

# 오버레이 검증 이미지 전체(92장, 83MB)는 로컬 보관.
# 대표 샘플은 calib_result/overlay_samples/ 에 축소본으로 커밋됨.
calib_result/*_overlay/

# 캘리브레이션 원본 압축본 (830MB, 로컬 보관)
calib_.zip

# 확인용 영상은 로컬에만 둔다 (~/ros2_ws/cam_lidar_recording/sessions/)
*.mp4

# 캘리브레이션 오버레이 원본 (85MB, 자세당 수십 장). 대표 샘플은 overlay_samples/ 에
calib_result/CAM*_overlay/
데이터_라벨링.zip

# 처리 결과 (수 GB). 데이터_위치.md 참고 — 언제든 다시 만들 수 있다
포인트보정/results/

# daheng 작업폴더의 녹화 데이터는 넣지 않는다 (55GB)
데이터_라벨링/code/daheng_ws_1/sessions/
데이터_라벨링/code/daheng_ws_1/sessions_camonly/
